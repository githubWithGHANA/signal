# ============================================================
# signal deployment configuration
# Copy to `.env` on the EC2 host (/opt/signal/.env) and fill in
# real values. docker compose auto-loads .env from this directory.
# ============================================================

# --- Image (set by start-docker.sh; defaults shown) ---
ECR_REPO=921829859169.dkr.ecr.ap-south-1.amazonaws.com/signal-app
FRONTEND_REPO=921829859169.dkr.ecr.ap-south-1.amazonaws.com/signal-frontend
IMAGE_TAG=latest

# --- Spring profile ---
SPRING_PROFILE=prod

# --- PostgreSQL (signal_db container) ---
DB_NAME=signal_dev
DB_USER=dev_admin
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Redis (signal_redis container) ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Broker SSO/XTS app key (dhanistocks/ibullssecurities) ---
BROKER_APPKEY=CHANGE_ME_APPKEY
